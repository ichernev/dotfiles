! Common terminal stuff
*scrollBar: 0
*foreground: gray
# *foreground: black
*color4: #5C5CFF
*color12: #5C5CFF
*saveLines: 1000000
*scrollTtyOutput: false
*scrollWithBuffer: true
*scrollTtyKeypress: true

! normal terminal
# urxvt*font: xft:DejaVu Sans Mono-20
# urxvt*background: #FFFFFF

! scratchpad
scratchpad*font: xft:Monospace-10
scratchpad*background: #111111
# scratchpad*font: xft:Monospace-25
# scratchpad*background: #FFFFFF

URxvt.iso14755: false
URxvt.iso14755_52: false
URxvt.font: xft:DejaVu Sans Mono:size=10
URxvt.background: #000000
URxvt.perl-ext-common: default,resize-font
URxvt.keysym.C-equal: resize-font:bigger
URxvt.keysym.C-0: resize-font:reset
URxvt.keysym.4-v: eval:paste_clipboard

XTerm*renderFont: true
XTerm*faceName: xft:Droid Sans Mono-10
XTerm*background: #000000

